# Copie para .env (NÃO envie o .env para o GitHub). Estes valores ficam SÓ no servidor.
PORT=8080

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave "service_role": acesso total ao banco. SECRETA. Nunca vai para o site/navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Só se o seu projeto usa o "JWT Secret" legado (HS256). Projetos novos (ES256) não precisam: o servidor usa o JWKS da SUPABASE_URL.
SUPABASE_JWT_SECRET=

# Endereços do seu site autorizados a conectar (separe por vírgula)
ALLOWED_ORIGINS=https://arena32.netlify.app

# NUNCA use 1 em produção. Só para testar localmente sem Supabase.
ALLOW_GUEST=0
